[tasks]
bmc
cover
prove
pdr
bmc3

[options]
bmc:   mode bmc
bmc:   depth 40
cover: mode cover
cover: depth 40
prove: mode prove
prove: depth 30
pdr:   mode prove
bmc3:  mode bmc
bmc3:  depth 40

[engines]
bmc: smtbmc yices
cover: smtbmc yices
prove: smtbmc yices
pdr: abc pdr
bmc3: abc bmc3

[script]
plugin -i ghdl
ghdl --std=08 -fpsl spwpkg.vhd spwlink.vhd spwlink_formal.vhd -e spwlink_formal
prep -top spwlink_formal

[files]
../spacewire_light/rtl/vhdl/spwpkg.vhd
../spacewire_light/rtl/vhdl/spwlink.vhd
spwlink_formal.vhd
